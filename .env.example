NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
AUTH_PROVIDER=local
LOCAL_BOOTSTRAP_TOKEN=replace-with-a-random-32-character-local-only-token
OPENAPI_DOCS_ENABLED=false
DATABASE_URL=postgresql://jackys:jackys@localhost:5432/jackys_service_portal
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-service-files
ATTACHMENT_STORAGE_DIR=storage/attachments
ATTACHMENT_URL_SECRET=replace-with-a-random-32-character-local-only-secret
# Chat: delete messages (and their files) older than this many days; 0 or unset keeps everything. Minimum 30. Pinned messages are always kept.
CHAT_RETENTION_DAYS=0
# Chat background alerts (browser push when the portal is closed). Generate keys with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Chat mention emails: sent only if still unread after this many minutes (needs EMAIL_ENABLED=true, EMAIL_FROM and EMAIL_PROVIDER_API_KEY; provider: resend)
CHAT_EMAIL_DELAY_MINUTES=5
# Public address of the portal, used in mention emails, for example https://service.example.com
PORTAL_PUBLIC_URL=
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
BUSINESS_TIMEZONE=Asia/Dubai
